# Normalize line endings so macOS and Windows checkouts stay identical (LF everywhere).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts: never diff or convert.
*.pkl binary
*.sqlite binary
*.pt binary
*.bin binary
*.safetensors binary
*.png binary
*.jpg binary
*.pdf binary
