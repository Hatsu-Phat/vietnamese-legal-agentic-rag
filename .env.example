# Copy to .env, then fill in the values. Keep your actual .env out of Git.

# --- Qdrant Cloud (legal corpus + enterprise internal documents) ---
QDRANT_MODE=server
QDRANT_URL=https://YOUR-CLUSTER-ENDPOINT:6333
# Serving only needs read access. Publishing a new release (PROJECT_PLAN P1) needs a key with write access.
QDRANT_API_KEY=

# Optional: server request timeout in seconds (default: 15).
# TOOL_TIMEOUT_SECONDS=15

# Local storage: set QDRANT_MODE=local; URL/API key are unused in local mode.
# Model, collection, chunking and data paths: configs/dev.yaml.
# Embedding device: CLI --device auto|cpu|mps|cuda.

# --- Cloud LLM (Gemini, used for hard questions) ---
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# LLM_TIMEOUT_SECONDS=30
# MAX_RETRIEVAL_ROUNDS=2
# STRICT_CITATION_VERIFICATION=true

# --- Local LLM (Ollama, used for confidential data and simple questions) ---
# Planned in PROJECT_PLAN P3; not read by the code yet.
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TIMEOUT_SECONDS=60
# local | cloud | router (router: confidential/PII/simple -> local, otherwise cloud)
LLM_ROUTING_MODE=router

# --- Role-based access (demo API keys, sent as X-API-Key) ---
# Planned in PROJECT_PLAN P2; not read by the code yet. Use long random strings.
AUTH_API_KEY_EMPLOYEE=
AUTH_API_KEY_MANAGER=
AUTH_API_KEY_LEGAL=
