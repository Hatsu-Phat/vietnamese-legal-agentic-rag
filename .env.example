# ==============================================================================
# Environment Configuration Template for Vietnamese Legal Agentic RAG
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file with secrets into version control!
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash
# Alternative provider options:
# LLM_API_KEY=your_llm_api_key_here
# LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30


# ------------------------------------------------------------------------------
# Embedding & Retrieval Settings
# ------------------------------------------------------------------------------
# Default Dense Model: BAAI/bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu  # 'cuda' or 'cpu'
CHROMA_PERSIST_DIRECTORY=./data/indexes/chroma
METADATA_DB_URL=sqlite:///./data/metadata.db

# ------------------------------------------------------------------------------
# Agent Execution & Safety Bounds
# ------------------------------------------------------------------------------
# Maximum bounded retry loops for agent retrieval
MAX_RETRIEVAL_ROUNDS=2
# Total tool execution timeout
TOOL_TIMEOUT_SECONDS=15
# Require citation ID existence check before response release
STRICT_CITATION_VERIFICATION=true

# ------------------------------------------------------------------------------
# Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=vietnamese-legal-agentic-rag
